{
  "name": "orbit-chat-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Independent web and desktop chat UI starter",
  "main": "desktop/main.cjs",
  "scripts": {
    "web": "vite --host 127.0.0.1",
    "desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:build": "electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "app.orbitchat.desktop",
    "productName": "Orbit Chat",
    "files": [
      "web/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  }
}